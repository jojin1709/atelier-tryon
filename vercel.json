{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/tokens",
      "dest": "/api/tokens.js"
    },
    {
      "src": "/api/proxy-image",
      "dest": "/api/proxy-image.js"
    },
    {
      "src": "/demo",
      "dest": "/index.html"
    },
    {
      "src": "/widget.html",
      "dest": "/extension/widget.html"
    },
    {
      "src": "/(widget-.*\\.js|local-engine\\.js|billing\\.js|config\\.js|connection-indicator\\.js|logger\\.js|recording\\.js|stream-quality\\.js)",
      "dest": "/extension/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
